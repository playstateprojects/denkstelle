# Copy to processor/.secrets (gitignored) and fill in, then: npm run processor:secrets
# These become secrets on the denkstelle-processor Worker and are passed on to the container at start.
# DATABASE_URL must be a direct/pooled Postgres URL, NOT the Hyperdrive binding (the container has no bindings).
# The R2 keys are an R2 API token's S3 credentials, scoped to the denkstelle-private bucket.
DATABASE_URL=postgresql://user:password@host:5432/denkstelle
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
WORKERS_AI_API_TOKEN=
DEEPSEEK_API_KEY=
