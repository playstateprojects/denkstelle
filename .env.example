# Use a NEW Denkstelle database. Never reuse Space Between's production database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/denkstelle
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
ADMIN_EMAILS=you@example.com
RESEND_API_KEY=
EMAIL_FROM=Denkstelle <hello@your-verified-domain.example>
# Only required for the standalone processing/render scripts:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=denkstelle-private
WORKERS_AI_API_TOKEN=
DEEPSEEK_API_KEY=
# Optional for writing participant receipts:
PUBLIC_ORIGIN=http://localhost:5173
