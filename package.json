{
  "name": "denkstelle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/vite/bin/vite.js dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "process:once": "node --env-file=.env --import tsx scripts/process-pending.ts",
    "themes:rebuild": "node --env-file=.env --import tsx scripts/rebuild-themes.ts",
    "render":"node --env-file=.env --import tsx scripts/render-highlight.ts",
    "admin:grant": "node --env-file=.env --import tsx scripts/grant-admin.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "worker:dev": "node --env-file=.env --import tsx worker/src/server.ts",
    "test:worker": "node --import tsx --test worker/test/queue.test.ts worker/test/reel.test.ts",
    "check:worker": "tsc -p worker/tsconfig.json && tsc -p processor/tsconfig.json",
    "deploy": "wrangler deploy",
    "deploy:processor": "wrangler deploy -c processor/wrangler.jsonc",
    "processor:secrets": "wrangler secret bulk processor/.secrets -c processor/wrangler.jsonc",
    "processor:logs": "wrangler tail denkstelle-processor"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "3d-force-graph": "^1.80.1",
    "better-auth": "^1.7.14",
    "bits-ui": "^2.20.6",
    "pg": "^8.16.3",
    "postgres": "^3.4.9",
    "resend": "^6.35.0",
    "three": "^0.186.0",
    "three-spritetext": "^1.10.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/three": "^0.186.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.45.0"
  }
}
